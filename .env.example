# Freedom Studio — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
#
# Secrets inventory: docs/08-security-threat-model.md §4.4
# Config inventory:  docs/10-deployment-operations.md
#
# INVARIANT (docs/05-auth-2fa.md §7): the browser only ever holds the anon key.
# Anything that is not NEXT_PUBLIC_* is server-scope only and must never be
# imported into a client component or serialized into a page payload.

# --- Public (safe to ship to the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets --------------------------------------------------
# Full RLS bypass. Used only behind guardedAdminClient() (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin of the deployment, e.g. https://studio.example.com
# Used for invite redirects, share links and absolute URLs in server code.
APP_BASE_URL=

# --- LLM providers (server-only, docs/11-ai-llm.md) -----------------------
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
